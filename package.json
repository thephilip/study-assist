{
	"name": "study-assist",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"build:studio": "tsc && STUDIO=1 vite build --base=/studio/app/ --outDir dist-studio",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"build:native": "tsc && NATIVE=1 vite build --outDir dist-native && npx cap copy"
	},
	"devDependencies": {
		"@capacitor/android": "^8.4.1",
		"@capacitor/cli": "^8.4.1",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"typescript": "^6.0.3",
		"vite": "^8.0.14",
		"vite-plugin-pwa": "^1.3.0"
	},
	"dependencies": {
		"@capacitor/core": "^8.4.1",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"workbox-window": "^7.4.1"
	}
}
